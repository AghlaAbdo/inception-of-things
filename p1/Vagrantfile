
Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-26.04"

  config.vm.provider "virtualbox" do |vb|
    vb.memory = 1024
    vb.cpus = 1
  end

  # First VM: Kubernetes server
  config.vm.define "aaghlaS" do |server|
    server.vm.hostname = "aaghlaS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provision "shell", path: "scripts/server.sh"
  end

  # Second VM: Kubernetes worker
  config.vm.define "aaghlaSW" do |worker|
    worker.vm.hostname = "aaghlaSW"
    worker.vm.network "private_network", ip: "192.168.56.111"

    worker.vm.provision "shell", path: "scripts/worker.sh"
  end
end
