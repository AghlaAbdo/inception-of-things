
Vagrant.configure("2") do |config|
  # Use the same working box as your Part 1 Vagrantfile.
  config.vm.box = "bento/ubuntu-26.04"

  config.vm.define "aaghlaS" do |server|
    server.vm.hostname = "aaghlaS"

    server.vm.network "private_network",
      ip: "192.168.56.110"

    server.vm.provider "virtualbox" do |vb|
      vb.name = "iot-p2-server"
      vb.memory = 2048
      vb.cpus = 1
    end

    server.vm.provision "shell",
      path: "scripts/server.sh"
  end
end
